# Clave de API de Google Gemini.
# Obtén una en: https://aistudio.google.com/app/apikey
# No subas este archivo con credenciales reales al repositorio.
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de embeddings (Google Gemini)
EMBEDDING_MODEL=gemini-embedding-001

# Modelo generativo (Google Gemini)
GENERATION_MODEL=gemini-3.8-flash

# División de documentos
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Recuperación
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Límite de subida (MB)
MAX_FILE_SIZE_MB=10

# Directorio de persistencia local de la base vectorial (NumPy)
VECTOR_STORE_DIR=./vector_store